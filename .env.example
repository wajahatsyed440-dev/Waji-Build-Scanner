# Configure these as PRIVATE environment variables in your cloud service.
API_KEY=YOUR_OWN_AUTHORISED_API_KEY
API_PATHS=/api/builds,/api/old_build
SCAN_INTERVAL=60
# Choose a random hard-to-guess ntfy topic; copy exactly into the ntfy app
NTFY_TOPIC=waji-change-me-to-a-long-random-secret-topic
# 12+ characters, ideally randomly generated
DASHBOARD_PASSWORD=replace-with-a-strong-private-password
# Fill in your cloud service's HTTPS address after deployment
PUBLIC_URL=https://your-project.example.com
DATA_DIR=/data
